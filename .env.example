DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=
DJANGO_TIME_ZONE=Asia/Kolkata
DJANGO_SECURE_SSL_REDIRECT=true

DB_NAME=shine_crawler
DB_USER=shine_crawler
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_BROKER_DB=1
REDIS_RESULT_DB=2
REDIS_STATE_DB=3

SHINE_BASE_URL=https://recruiter.shine.com
SHINE_STORAGE_STATE_PATH=
SHINE_SEARCH_TERMS=
# Only used once by `manage.py shine_login` to save session cookies —
# crawler/browser.py itself never logs in, only reuses the saved file.
SHINE_LOGIN_EMAIL=
SHINE_LOGIN_PASSWORD=

NIGHT_START_HOUR=23
NIGHT_START_MINUTE=0
NIGHT_END_HOUR=5
NIGHT_END_MINUTE=0
SUBMISSION_END_HOUR=10
SUBMISSION_END_MINUTE=0
CONTROL_TICK_INTERVAL_SECONDS=60
AUTO_SUBMIT_INTERVAL_SECONDS=360
AUTO_SUBMIT_QUEUE_THRESHOLD=300
AUTO_SUBMIT_BATCH_SIZE=100
POLLING_TICK_INTERVAL_SECONDS=180
POLLING_BATCH_SIZE=50

CRAWLER_MAX_CONCURRENT_BROWSERS=1
CRAWLER_PAGE_LOAD_TIMEOUT_MS=30000
CRAWLER_DELAY_MIN_SECONDS=3
CRAWLER_DELAY_MAX_SECONDS=8
CRAWLER_MAX_RETRIES_PER_PAGE=2
CRAWLER_MAX_LOAD_AVERAGE=2.0

EXTENSION_API_BASE_URL=
EXTENSION_API_KEY=
EXTENSION_SUBMIT_TIMEOUT_SECONDS=15
# Either set EXTENSION_CREATED_BY_ID directly, OR leave it blank and
# set the two login vars below — the id is then resolved automatically
# via the same endpoint the extension's own login panel calls.
EXTENSION_CREATED_BY_ID=
EXTENSION_LOGIN_URL=https://white-force.com/plus/api/login-from-extension
EXTENSION_LOGIN_EMAIL=
EXTENSION_LOGIN_PASSWORD=
# TODO: content.js's own STATUS_API_ENDPOINT constant disagrees with
# what its pollJobStatus() function actually calls — see base.py note.
EXTENSION_STATUS_API_URL=https://astro-buddy.in/AI/candidate-extension/status
