[Unit]
Description=Shine Night Crawler - Gunicorn web server
After=network.target postgresql.service redis-server.service

[Service]
Type=notify
User=crawler
Group=crawler
WorkingDirectory=/opt/shine-night-crawler
EnvironmentFile=/opt/shine-night-crawler/.env
Environment=DJANGO_SETTINGS_MODULE=config.settings.production
ExecStart=/opt/shine-night-crawler/venv/bin/gunicorn config.wsgi:application \
    --bind 127.0.0.1:8000 \
    --workers 2 \
    --timeout 60
ExecReload=/bin/kill -s HUP $MAINPID
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
